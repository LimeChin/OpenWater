# Water API 环境变量示例
# 请复制此文件为 .env 并填入实际的值

# One-API 配置
ONE_API_DB=/opt/one-api/data/one-api.db
ONE_API_URL=http://one-api:3000

# 发卡程序配置
FAKA_PORT=3001
FAKA_HOST=0.0.0.0

# 虎皮椒支付配置
XUNHUPAY_APPID=your_appid_here
XUNHUPAY_SECRET=your_secret_here
XUNHUPAY_API_URL=https://api.xunhupay.com/payment/do.html

# OpenRouter API
OPENROUTER_API_KEY=your_openrouter_key_here

# Groq API (可选)
GROQ_API_KEY=your_groq_key_here

# DeepSeek API (可选)
DEEPSEEK_API_KEY=your_deepseek_key_here

# 定价配置
QUOTA_PER_YUAN=10000  # 1 元 = 10,000 积分
